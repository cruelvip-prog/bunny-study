# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=your_gemini_api_key_here

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase project configuration for email/password authentication.
# Use the project URL and publishable key; never put a service_role key here.
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"

# Optional read-only remote question-bank projects.
# Use publishable keys only; never put a service_role or secret key in Vite env.
VITE_SUPABASE_PHYSICS_URL=""
VITE_SUPABASE_PHYSICS_PUBLISHABLE_KEY=""
VITE_SUPABASE_BIOLOGY_URL=""
VITE_SUPABASE_BIOLOGY_PUBLISHABLE_KEY=""
VITE_SUPABASE_CHEMISTRY_URL=""
VITE_SUPABASE_CHEMISTRY_PUBLISHABLE_KEY=""
VITE_SUPABASE_GENERAL_URL=""
VITE_SUPABASE_GENERAL_PUBLISHABLE_KEY=""
VITE_SUPABASE_ARCHIVE_URL=""
VITE_SUPABASE_ARCHIVE_PUBLISHABLE_KEY=""
VITE_SUPABASE_PYQ_URL=""
VITE_SUPABASE_PYQ_PUBLISHABLE_KEY=""

# Optional: base URL for the trusted admin API when it is not served from the
# same origin as the app. Defaults to /api. Do not put service-role keys here.
# VITE_ADMIN_API_BASE_URL="https://your-admin-api.example.com/api"
