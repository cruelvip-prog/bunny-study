# Trusted admin API environment. Copy to .env.server and fill values locally.
# NEVER expose these values in VITE_* variables, browser bundles, or chat.
# The main project uses only its publishable key here. Each remote project uses
# a service-role key that is read only by the Node server.

# Main OINKIE Study project: verifies the existing admin session and is_admin().
OINKIE_MAIN_SUPABASE_URL="https://your-main-project.supabase.co"
OINKIE_MAIN_SUPABASE_PUBLISHABLE_KEY="your-main-supabase-publishable-key"

# Physics project -> public.physics_questions
OINKIE_PHYSICS_SUPABASE_URL="https://your-physics-project.supabase.co"
OINKIE_PHYSICS_SUPABASE_SERVICE_ROLE_KEY=""

# Biology project -> public.biology_questions
OINKIE_BIOLOGY_SUPABASE_URL="https://your-biology-project.supabase.co"
OINKIE_BIOLOGY_SUPABASE_SERVICE_ROLE_KEY=""

# Chemistry project -> public.chemistry_questions
OINKIE_CHEMISTRY_SUPABASE_URL="https://your-chemistry-project.supabase.co"
OINKIE_CHEMISTRY_SUPABASE_SERVICE_ROLE_KEY=""

# General project -> public.question_bank
OINKIE_GENERAL_SUPABASE_URL="https://your-general-project.supabase.co"
OINKIE_GENERAL_SUPABASE_SERVICE_ROLE_KEY=""

# Archive project -> public.question_bank_archive
OINKIE_ARCHIVE_SUPABASE_URL="https://your-archive-project.supabase.co"
OINKIE_ARCHIVE_SUPABASE_SERVICE_ROLE_KEY=""

# PYQ project -> public.pyq_questions
OINKIE_PYQ_SUPABASE_URL="https://your-pyq-project.supabase.co"
OINKIE_PYQ_SUPABASE_SERVICE_ROLE_KEY=""

# Port for the trusted admin API. The Vite dev proxy targets 3001.
PORT=3001

# Supabase Before User Created Auth Hook secret. Generate with:
# echo "v1,whsec_$(openssl rand -base64 32)"
# Configure the same value in Supabase Auth Hooks. Leave unset only for local
# development without signature verification.
OINKIE_BEFORE_USER_CREATED_HOOK_SECRET="v1,whsec_your-base64-secret"
